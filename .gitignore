# Runner source frames (regenerable via make_runner.py). The consumed
# artifact my-app/public/runner.b64.txt IS committed — app/page.tsx reads it
# at build time, so Vercel git auto-deploy needs it in the repo (without it
# the build fails with ENOENT on readFileSync). Keeping it gitignored was the
# real cause of the long-standing "auto-deploy broken" (misdiagnosed as a
# Git-integration defect).
runner_*.png
my-app/data/

# Verification screenshots (Playwright captures)
hero-*.png
my-app/*.png

# Internal handoff notes (contain local machine paths)
HANDOFF.md

# Superpowers brainstorming session artifacts
.superpowers/

# Python
__pycache__/
*.pyc

# Vercel
.vercel/

# Node (if any tooling is added later)
node_modules/

# Env / secrets
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
.vercel
.env*
